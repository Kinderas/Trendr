[Unit]
Description=OF Telegram auto-poster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/of-telegram-bot
EnvironmentFile=/opt/of-telegram-bot/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
# Soft hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
