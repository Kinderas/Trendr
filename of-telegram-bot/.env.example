# Required: bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Required: destination chat (channel @username, or numeric id for groups/supergroups)
# Channel example: @mychannel  or  -100xxxxxxxxxx
# Tip: forward a channel message to @userinfobot / @getidsbot to find the id
TELEGRAM_CHAT_ID=@your_channel_or_-100xxxxxxxxxx

# Required: root folder that contains one subfolder per model
# Windows (source PC): C:\Users\alexa\Pictures\Telegram Models
# Linux VPS (after sync): /var/media/telegram-models
MEDIA_ROOT=/var/media/telegram-models

# Optional: premium CTA URL (default shown)
PREMIUM_URL=https://dailyleaksss.com

# Optional: hours between automatic posts (default 3)
POST_INTERVAL_HOURS=3

# Optional: comma-separated Telegram user ids allowed to run /post, /status, /models
# Leave empty to disable admin commands (scheduler still runs)
ADMIN_USER_IDS=

# Optional: set to 1 to log selections without sending to Telegram
DRY_RUN=0

# Optional: path to posted-file state JSON (default: ./data/posted-state.json)
# STATE_FILE=./data/posted-state.json
